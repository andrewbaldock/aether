# The backend reads its own backend/.env — see backend/.env.example for the
# variables it needs (LLM_PROVIDER, ANTHROPIC_API_KEY, ...). This root file lists
# everything the project will use as it grows.

# LLM provider — claude | gemini | ollama
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (persistence — not wired up yet)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
