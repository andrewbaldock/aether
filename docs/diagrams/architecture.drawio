        <mxCell id="be-r-chat" value="POST /api/chat  ← SSE stream response" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="be-zone-routes">
          <mxGeometry x="20" y="520" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="be-r-screenshots" value="POST /api/screenshots/run  [dev only]" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="be-zone-routes">
          <mxGeometry x="20" y="575" width="320" height="32" as="geometry"/>
        </mxCell>

        <!-- ── AGENT LOOP ZONE ── -->
        <mxCell id="be-zone-agent" value="Agent Loop" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="400" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="be-a-receive" value="1. Receive user message + sessionId" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="50" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-load" value="2. Load conversation history from Supabase" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="100" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-emit-loop" value="3. Emit: loop_start · status · plan" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="150" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-llm" value="4. Call LLM with full conversation + tool specs" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="200" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-stream" value="5. Stream text chunks → SSE: text" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="250" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-tooluse" value="6. On tool_use: emit tool_start → execute tool" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="300" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-toolpartial" value="7. Render tools: stream tool_partial chunks progressively" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="350" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-toolresult" value="8. Emit tool_result JSON → append to conversation" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="400" width="340" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="be-a-loop" value="9. Loop → step 4 until no more tool_use" style="rounded=1;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=10;fontStyle=2;" vertex="1" parent="be-zone-agent">
          <mxGeometry x="30" y="450" width="340" height="35" as="geometry"/>
        </mxCell>

        <!-- ── LLM CONNECTOR ZONE ── -->
