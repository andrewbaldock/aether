# Copy to backend/.env and fill in. bun auto-loads backend/.env when you run the
# server from the backend/ directory. .env is gitignored — never commit real keys.

# Provider routing is decided by the chosen MODEL, not a global setting: each model
# in the allowlist (src/models.ts) is tagged with its provider, and the factory in
# src/llm.ts routes to the matching client. So you don't set a provider here — you
# just set the API keys for whichever providers you want available in the picker.
# A provider's key is only needed when a turn actually uses one of its models
# (keys are read lazily), so Anthropic alone is enough to run.

# Required to run the backend (Claude is the default model).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: keys for the other (free-tier) providers. Set whichever you want to
# offer. A model whose key is unset still shows in the picker but errors on use.
#   Google AI Studio (Gemini, free tier):   https://aistudio.google.com/apikey
#   DeepSeek:                                https://platform.deepseek.com/api_keys
#   Mistral (La Plateforme, free Experiment): https://console.mistral.ai/api-keys
# GOOGLE_AI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# Optional: override the default Claude model (defaults to claude-sonnet-4-6).
# This is the fallback when a request/session doesn't pick one. The in-app model
# picker (see src/models.ts for the allowlist) overrides this per conversation.
# Applies to Claude only; the OpenAI-compatible providers use LLM_MAX_TOKENS below.
# ANTHROPIC_MODEL=claude-opus-4-8

# Optional: output token budget for the OpenAI-compatible providers (Google /
# DeepSeek / Mistral). Defaults to 4096. (Claude's budget is ANTHROPIC_MAX_TOKENS.)
# LLM_MAX_TOKENS=4096

# Optional: override the port the server binds (defaults to 8000 — the port the
# frontend's Vite proxy forwards /api to).
# PORT=8000

# Optional: Unsplash access key for the search_images tool. Image search works
# fully keyless on Wikimedia Commons; adding this ALSO polls Unsplash and merges
# its (glossier) photos in. Register a free app, copy the "Access Key" (the
# public Client-ID, not the Secret): https://unsplash.com/developers
# Free demo tier is 50 requests/hour SHARED ACROSS THE WHOLE APP — Aether
# enforces an app-wide cap of 45/hr via the app_state counter table (run
# sql/001_app_state.sql once), degrading to Wikimedia-only when spent. Without
# this key, only Wikimedia is used.
# UNSPLASH_ACCESS_KEY=

# Supabase — session + message persistence. Get these from the Supabase dashboard
# under Settings → API. The anon key is safe to use client-side; RLS can be added
# later if multi-user auth is introduced.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
