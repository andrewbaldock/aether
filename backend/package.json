{
  "name": "@aether/backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
