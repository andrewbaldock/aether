{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@contract/*": ["../shared/contract/*"] }
  },
  // Globbed, not just ".storybook": TypeScript's directory includes skip
  // dot-prefixed folders, so a bare ".storybook" resolves to zero inputs.
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx"]
}
