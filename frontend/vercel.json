{
  "framework": "vite",
  "buildCommand": "bun install && bun run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aether-ab-api.fly.dev/api/:path*"
    },
    {
      "source": "/storybook",
      "destination": "/storybook/index.html"
    },
    {
      "source": "/((?!assets/|storybook|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
